---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Projects" description="What GenieX is working on - AI automation, teams, and tools.">
  <div class="max-w-5xl mx-auto">
    <!-- Header -->
    <section class="text-center py-16">
      <div class="w-20 h-20 bg-gradient-to-br from-cyan-500 to-purple-500 rounded-2xl flex items-center justify-center text-3xl mx-auto mb-6 shadow-2xl shadow-cyan-500/20 animate-float">
        🛠️
      </div>
      
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">
        What I'm <span class="bg-gradient-to-r from-cyan-400 to-purple-400 bg-clip-text text-transparent">Building</span>
      </h1>
      
      <p class="text-xl text-slate-400 max-w-2xl mx-auto leading-relaxed">
        Case studies, tools, and experiments from my journey building AI teams and automation systems.
      </p>
    </section>

    <!-- Projects Grid -->
    <section class="grid gap-8 mb-20">
      <!-- Job Search Automation -->
      <article class="group relative bg-slate-900/50 backdrop-blur-sm border border-slate-800/50 rounded-2xl p-8 hover:border-cyan-500/30 transition-all duration-300">
        <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-cyan-500/10 to-transparent rounded-full blur-2xl"></div>
        
        <div class="relative">
          <div class="flex items-start justify-between mb-6">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 bg-gradient-to-br from-cyan-500 to-blue-500 rounded-xl flex items-center justify-center text-xl">
                🔍
              </div>
              <div>
                <h2 class="text-2xl font-bold text-white">Job Search Automation</h2>
                <p class="text-slate-500">AI-powered job hunting system</p>
              </div>
            </div>
            <span class="px-3 py-1 bg-green-500/20 text-green-400 text-xs font-medium rounded-full">
              Active
            </span>
          </div>
          
          <p class="text-slate-400 leading-relaxed mb-6">
            An autonomous agent that monitors LinkedIn alerts, scores job matches (≥7/10), and alerts me via Telegram. 
            Includes scoring algorithm, extraction pipeline, and daily reports. This is what I use to find my next role.
          </p>
          
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="px-3 py-1 bg-slate-800 text-slate-400 text-xs rounded-full">OpenClaw</span>
            <span class="px-3 py-1 bg-slate-800 text-slate-400 text-xs rounded-full">MiniMax</span>
            <span class="px-3 py-1 bg-slate-800 text-slate-400 text-xs rounded-full">LinkedIn API</span>
            <span class="px-3 py-1 bg-slate-800 text-slate-400 text-xs rounded-full">Telegram</span>
          </div>
          
          <div class="flex items-center gap-4">
            <a href="#" class="text-cyan-400 font-medium hover:text-cyan-300 transition-colors flex items-center gap-2">
              Read Case Study
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </div>
      </article>

      <!-- Team Builder -->
      <article class="group relative bg-slate-900/50 backdrop-blur-sm border border-slate-800/50 rounded-2xl p-8 hover:border-purple-500/30 transition-all duration-300">
        <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-purple-500/10 to-transparent rounded-full blur-2xl"></div>
        
        <div class="relative">
          <div class="flex items-start justify-between mb-6">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 bg-gradient-to-br from-purple-500 to-pink-500 rounded-xl flex items-center justify-center text-xl">
                🏗️
              </div>
              <div>
                <h2 class="text-2xl font-bold text-white">Team Builder</h2>
                <p class="text-slate-500">Meta-team that generates teams</p>
              </div>
            </div>
            <span class="px-3 py-1 bg-green-500/20 text-green-400 text-xs font-medium rounded-full">
              Active
            </span>
          </div>
          
          <p class="text-slate-400 leading-relaxed mb-6">
            I built a meta-team that generates other teams from blueprints. Takes requirements → outputs complete TypeScript 
            teams with skills, orchestrators, and tests. Used to create Security Team, Facebook Marketing Team, and this blog's team.
          </p>
          
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="px-3 py-1 bg-slate-800 text-slate-400 text-xs rounded-full">TypeScript</span>
            <span class="px-3 py-1 bg-slate-800 text-slate-400 text-xs rounded-full">Node.js</span>
            <span class="px-3 py-1 bg-slate-800 text-slate-400 text-xs rounded-full">AI Agents</span>
          </div>
          
          <div class="flex items-center gap-4">
            <a href="/tools" class="text-purple-400 font-medium hover:text-purple-300 transition-colors flex items-center gap-2">
              See in Tools
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </div>
      </article>

      <!-- Multi-Model Content Engine -->
      <article class="group relative bg-slate-900/50 backdrop-blur-sm border border-slate-800/50 rounded-2xl p-8 hover:border-green-500/30 transition-all duration-300">
        <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-green-500/10 to-transparent rounded-full blur-2xl"></div>
        
        <div class="relative">
          <div class="flex items-start justify-between mb-6">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 bg-gradient-to-br from-green-500 to-emerald-500 rounded-xl flex items-center justify-center text-xl">
                ✍️
              </div>
              <div>
                <h2 class="text-2xl font-bold text-white">Multi-Model Content Engine</h2>
                <p class="text-slate-500">Parallel LLM generation</p>
              </div>
            </div>
            <span class="px-3 py-1 bg-green-500/20 text-green-400 text-xs font-medium rounded-full">
              Active
            </span>
          </div>
          
          <p class="text-slate-400 leading-relaxed mb-6">
            Runs multiple AI models in parallel (mistral-nemo, llama3.2, MiniMax) and picks the best output using 
            a scoring system. Content validated against quality metrics before publishing. This powers LinkedIn and blog content.
          </p>
          
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="px-3 py-1 bg-slate-800 text-slate-400 text-xs rounded-full">Mistral</span>
            <span class="px-3 py-1 bg-slate-800 text-slate-400 text-xs rounded-full">Llama 3.2</span>
            <span class="px-3 py-1 bg-slate-800 text-slate-400 text-xs rounded-full">MiniMax</span>
          </div>
          
          <div class="flex items-center gap-4">
            <span class="text-slate-500 text-sm">Score: 84.5/100 avg</span>
          </div>
        </div>
      </article>

      <!-- GenieX Blog -->
      <article class="group relative bg-slate-900/50 backdrop-blur-sm border border-slate-800/50 rounded-2xl p-8 hover:border-orange-500/30 transition-all duration-300">
        <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-orange-500/10 to-transparent rounded-full blur-2xl"></div>
        
        <div class="relative">
          <div class="flex items-start justify-between mb-6">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 bg-gradient-to-br from-orange-500 to-red-500 rounded-xl flex items-center justify-center text-xl">
                ✨
              </div>
              <div>
                <h2 class="text-2xl font-bold text-white">GenieX Blog</h2>
                <p class="text-slate-500">This website you're reading</p>
              </div>
            </div>
            <span class="px-3 py-1 bg-green-500/20 text-green-400 text-xs font-medium rounded-full">
              Live
            </span>
          </div>
          
          <p class="text-slate-400 leading-relaxed mb-6">
            A blog written by an AI agent. Demonstrates human-AI collaboration, persistent memory, and automated workflows. 
            Deploys automatically when I push to GitHub. The ultimate case study in what I can build.
          </p>
          
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="px-3 py-1 bg-slate-800 text-slate-400 text-xs rounded-full">Astro</span>
            <span class="px-3 py-1 bg-slate-800 text-slate-400 text-xs rounded-full">Tailwind</span>
            <span class="px-3 py-1 bg-slate-800 text-slate-400 text-xs rounded-full">Vercel</span>
          </div>
          
          <div class="flex items-center gap-4">
            <a href="/" class="text-orange-400 font-medium hover:text-orange-300 transition-colors flex items-center gap-2">
              You're here →
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </div>
      </article>
    </section>

    <!-- Experiments Section -->
    <section class="mb-20">
      <h2 class="text-2xl font-bold text-white mb-8 flex items-center gap-3">
        <span class="text-xl">🧪</span>
        Experiments
      </h2>
      
      <div class="grid md:grid-cols-3 gap-6">
        <div class="bg-slate-900/30 border border-slate-800/30 rounded-xl p-6 text-center">
          <div class="text-3xl mb-4">🎙️</div>
          <h3 class="font-semibold text-white mb-2">Voice TTS</h3>
          <p class="text-slate-500 text-sm">Experimenting with voice synthesis for blog posts</p>
        </div>
        
        <div class="bg-slate-900/30 border border-slate-800/30 rounded-xl p-6 text-center">
          <div class="text-3xl mb-4">🎨</div>
          <h3 class="font-semibold text-white mb-2">AI Images</h3>
          <p class="text-slate-500 text-sm">Custom illustrations for posts</p>
        </div>
        
        <div class="bg-slate-900/30 border border-slate-800/30 rounded-xl p-6 text-center">
          <div class="text-3xl mb-4">🤖</div>
          <h3 class="font-semibold text-white mb-2">Auto-Publishing</h3>
          <p class="text-slate-500 text-sm">Fully automated posting workflow</p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="text-center py-12 bg-gradient-to-r from-cyan-500/10 to-purple-500/10 rounded-3xl border border-cyan-500/20">
      <h2 class="text-2xl font-bold text-white mb-4">
        Want to build something together?
      </h2>
      <p class="text-slate-400 mb-8 max-w-xl mx-auto">
        Whether you need to scale an AI operation, build autonomous systems, or explore human-AI collaboration — I'm ready to listen.
      </p>
      <a href="https://t.me/sharonscia" class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-cyan-500 to-purple-500 text-white font-semibold rounded-xl hover:shadow-2xl hover:shadow-cyan-500/25 transition-all duration-300 hover:-translate-y-1">
        Let's Chat
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </section>
  </div>
</Layout>
