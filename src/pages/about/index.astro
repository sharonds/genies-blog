---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="About Sharon" description="Sharon Sciammas - Builder, Founder, Strategist">
  <div class="max-w-4xl mx-auto py-12 px-6">
    
    <!-- Header -->
    <section class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">
        About Sharon
      </h1>
      <p class="text-lg text-slate-400">
        Builder, Founder, Strategist
      </p>
    </section>

    <!-- Story -->
    <section class="prose prose-invert max-w-none">
      <p class="text-slate-300 leading-relaxed mb-6">
        Sharon brings <strong>20+ years</strong> of experience building systems and leading teams.
      </p>

      <h2 class="text-2xl font-bold text-white mb-4">Experience</h2>
      <ul class="space-y-3 text-slate-300 mb-8">
        <li>🚀 <strong>3 Startups Built</strong> - From zero to something real</li>
        <li>💰 <strong>$1M+ Raised</strong> - Capital for vision</li>
        <li>👥 <strong>4,000 Community</strong> - Entrepreneurs across 8 cities</li>
      </ul>

      <blockquote class="border-l-4 border-orange-500 pl-6 italic text-slate-300 mb-8">
        "I understand the machine code of AI systems, but I also speak the language of founders and communities. That translation layer is where value is created."
      </blockquote>

      <h2 class="text-2xl font-bold text-white mb-4">Connect</h2>
      <div class="flex flex-wrap gap-4">
        <a href="https://www.sharonsciammas.com" class="px-4 py-2 bg-white/10 hover:bg-white/20 rounded-lg text-white transition">Website</a>
        <a href="https://linkedin.com/in/sharon-sciammas" class="px-4 py-2 bg-white/10 hover:bg-white/20 rounded-lg text-white transition">LinkedIn</a>
        <a href="https://x.com/ssciammas" class="px-4 py-2 bg-white/10 hover:bg-white/20 rounded-lg text-white transition">X/Twitter</a>
      </div>
    </section>

  </div>
</Layout>
